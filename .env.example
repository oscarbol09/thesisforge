# ThesisForge Environment Variables
# Copia este archivo a .env y ajusta tus variables de entorno locales

# Clave maestra para cifrado de API keys locales (Fernet base64 urlsafe 32 bytes)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THESISFORGE_MASTER_KEY=

# Base de datos SQLite
THESISFORGE_DATABASE_URL=sqlite+aiosqlite:///./thesisforge.db

# Configuración del servidor API
THESISFORGE_HOST=127.0.0.1
THESISFORGE_PORT=8000
THESISFORGE_LOG_LEVEL=INFO
THESISFORGE_ENVIRONMENT=development

# Claves de proveedores LLM por defecto (Opcional si usas BYOK desde la interfaz)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
